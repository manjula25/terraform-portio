.terraform/
.terraform.lock.hcl.bak

# Local values. Never credentials — those come from the environment.
*.tfvars
!*.tfvars.example

# State should live in GCS. A local state file here means someone ran
# apply before `terraform init` picked up the backend.
*.tfstate
*.tfstate.*

# Plan files can contain resolved variable values.
tfplan
*.tfplan
plan.txt

crash.log
crash.*.log
.DS_Store

# Credentials. These belong in the environment, never in the repo.
.env
.env.*
!.env.example

# Temporary local-state override while the GCS bucket is blocked on
# billing. Never commit a backend override or a local state file.
*_override.tf
tfplan-github
tfplan-github2
tfplan-entities
tfplan-rs
tfplan-ji
